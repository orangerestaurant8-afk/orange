# Railway supplies PORT automatically. Do not set it manually in production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
FRONTEND_ORIGIN=https://your-project.vercel.app
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
NODE_ENV=production
# Temporary testing only. Remove or set to false before public launch.
EXPOSE_OTP_IN_RESPONSE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Server-only POS integration settings. Never put these in frontend/.env files.
INTEGRATION_ENABLED=false
POS_API_URL=https://pos-api.example.com
POS_SYNC_SECRET=replace-with-a-long-shared-hmac-secret
# POS endpoint that receives signed ONLINE_ORDER_CREATED payloads.
POS_ORDER_WEBHOOK_PATH=/api/integration/website/orders
INTEGRATION_MAX_AGE_SECONDS=300
INTEGRATION_WORKER_INTERVAL_MS=15000
INTEGRATION_MAX_ATTEMPTS=8
DELIVERY_FEE=99
TAX_RATE=0.16
